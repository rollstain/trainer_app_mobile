<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:name=".TrainerApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Trainer">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="trainer" android:host="invite" />
                <data android:scheme="trainer" android:host="reset" />
                <data android:scheme="trainer" android:host="confirm" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="api.lyashukfit.ru"
                    android:pathPrefix="/i/" />
                <data
                    android:scheme="https"
                    android:host="lyashukfit.ru"
                    android:pathPrefix="/i/" />
                <data
                    android:scheme="https"
                    android:host="api.lyashukfit.ru"
                    android:pathPrefix="/r/" />
                <data
                    android:scheme="https"
                    android:host="lyashukfit.ru"
                    android:pathPrefix="/r/" />
                <data
                    android:scheme="https"
                    android:host="api.lyashukfit.ru"
                    android:pathPrefix="/c/" />
                <data
                    android:scheme="https"
                    android:host="lyashukfit.ru"
                    android:pathPrefix="/c/" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".RestTimerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.trainer.android.REST_FINISHED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".TrainerMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
